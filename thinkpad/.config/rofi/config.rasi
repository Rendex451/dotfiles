/* ~/dotfiles/common/.config/rofi/config.rasi */

configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus"; /* Можно заменить на ваш пакет иконок */
    terminal: "kitty";     /* Укажите ваш терминал */
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   ";
}

/* Импортируем динамический файл цветов */
@import "colors.rasi"

* {
    /* Шрифт совпадает с вашей панелью Waybar */
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 500px;
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
    border-radius: 20px;   /* Закругление окон, как у панели */
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 10px;
    margin: 0px 0px 15px 0px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent;
    padding: 0px 10px 0px 5px;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-alt;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 6;
    spacing: 6px;
}

element {
    background-color: transparent;
    text-color: @fg;
    border-radius: 12px;
    padding: 8px 12px;
}

element-icon {
    size: 24px;
    background-color: transparent;
    margin: 0px 10px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* Активный выбранный элемент */
element selected {
    background-color: @accent;
    text-color: @accent-text;
}
